# ═══════════════════════════════════════════════════════════════
# Destiny Rising Hub - Docker Compose Environment
# Copy this to .env and customize as needed
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=destiny_user
POSTGRES_PASSWORD=destiny_password
POSTGRES_DB=destiny_rising_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://destiny_user:destiny_password@postgres:5432/destiny_rising_hub?schema=public

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
BULLMQ_REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_GUI_PORT=8081

# ─── MinIO (S3) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=destiny-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000

# ─── Mailpit (SMTP) ─────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=noreply@destinyrisinghub.com

# ─── Application ─────────────────────────────────────────────
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-key-change-in-production-min-32-chars-long
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Destiny Rising Hub
NODE_ENV=development

# ─── OAuth Providers ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Seed Control ────────────────────────────────────────────
DATABASE_SEED=true

# ─── Monitoring ──────────────────────────────────────────────
SENTRY_DSN=
CDN_URL=

# ─── Feature Flags ──────────────────────────────────────────
ENABLE_NEW_FEATURES=false
ENABLE_BETA_FEATURES=false
