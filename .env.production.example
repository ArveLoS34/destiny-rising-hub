# ═══════════════════════════════════════════════════════════════
# Destiny Rising Hub — Production Environment Template
# ═══════════════════════════════════════════════════════════════
#
# Bu dosya production deployment için environment variable template'idir.
# Gerçek production ortamınızda bu değerleri güvenli şekilde yönetin:
#   - Secret'ları random ve yüksek entropi ile üretin
#   - Environment variable'ları hosting provider'ınızın secret management sistemi ile yönetin
#   - Bu dosyayı asla gerçek credential'lar ile commit etmeyin
#
# Kullanım: cp .env.production.example .env.production
#           Ardından .env.production dosyasını gerçek değerlerinizle doldurun
#
# ═══════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────
# Production ortamı için zorunlu
NODE_ENV="production"

# Public URL'ler (client-side ve server-side için)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_NAME="Destiny Rising Hub"

# ─── Authentication (Better Auth) ────────────────────────────
# KRITIK: Production için zorunlu değişkenler
#
# BETTER_AUTH_SECRET: Session cookie imzalama için kullanılır
#   - Minimum 32 karakter, yüksek entropi
#   - Örnek üretim: openssl rand -base64 48
#   - Asla paylaşmayın veya commit etmeyin
BETTER_AUTH_SECRET="generate-a-secure-random-64-char-string-here"

# BETTER_AUTH_URL: Auth endpoint base URL (opsiyonel)
#   - Belirtilmezse NEXT_PUBLIC_APP_URL kullanılır
#   - HTTPS olmalı (production'da)
BETTER_AUTH_URL="https://your-domain.com"

# TRUSTED_ORIGINS: CORS/CSRF koruması için trusted origin listesi (opsiyonel)
#   - Comma-separated liste
#   - Belirtilmezse NEXT_PUBLIC_APP_URL kullanılır
#   - Tüm origin'ler HTTPS olmalı (production'da)
TRUSTED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# ─── Database ────────────────────────────────────────────────
# KRITIK: Production PostgreSQL connection string
#   - Managed database service'ten alın (Supabase, Neon, RDS, vb.)
#   - SSL/TLS enabled olmalı
#   - Örnek: postgresql://user:password@host:5432/dbname?sslmode=require&schema=public
DATABASE_URL="postgresql://user:password@host:5432/destiny_rising_hub?sslmode=require&schema=public"

# ─── Redis ───────────────────────────────────────────────────
# KRITIK: Production Redis connection string
#   - Managed Redis service'ten alın (Upstash, Redis Cloud, ElastiCache, vb.)
#   - SSL/TLS enabled olmalı
#   - Örnek: rediss://user:password@host:6379 (rediss = SSL)
REDIS_URL="rediss://user:password@host:6379"

# BULLMQ_REDIS_URL: Queue için Redis (opsiyonel)
#   - Belirtilmezse REDIS_URL kullanılır
#   - Ayrı Redis instance önerilir (yüksek trafikli uygulamalar için)
BULLMQ_REDIS_URL="rediss://user:password@host:6379"

# ─── OAuth Providers (Optional) ──────────────────────────────
# OAuth provider'ları devre dışı bırakıldı (credentials yok)
# Etkinleştirmek için provider dashboard'dan credentials alın
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── Email (SMTP) ────────────────────────────────────────────
# Production SMTP service (SendGrid, Mailgun, AWS SES, vb.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@your-domain.com"

# ─── Object Storage (S3/R2) ─────────────────────────────────
# Production S3-compatible storage (AWS S3, Cloudflare R2, vb.)
S3_BUCKET="destiny-assets"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# ─── Monitoring ──────────────────────────────────────────────
# Sentry error tracking (opsiyonel ama önerilen)
# Sentry dashboard'dan DSN alın
SENTRY_DSN=""

# ─── Analytics (Optional) ────────────────────────────────────
# Google Analytics 4
GA4_MEASUREMENT_ID=""

# PostHog analytics
POSTHOG_API_KEY=""

# Vercel Analytics
VERCEL_ANALYTICS_ID=""

# ─── Feature Flags ──────────────────────────────────────────
# Production'da beta özellikler devre dışı bırakılmalı
ENABLE_NEW_FEATURES="false"
ENABLE_BETA_FEATURES="false"

# ─── Auth Rate Limiting (Optional) ───────────────────────────
# Better Auth rate limiting (Redis-backed, atomic)
# Default değerler auth config'de tanımlı, production'da tuning için override edilebilir
RATE_LIMIT_WINDOW="60"
RATE_LIMIT_MAX="100"
RATE_LIMIT_SIGNIN_WINDOW="900"
RATE_LIMIT_SIGNIN_MAX="5"
RATE_LIMIT_SIGNUP_WINDOW="3600"
RATE_LIMIT_SIGNUP_MAX="3"

# ─── CDN (Optional) ──────────────────────────────────────────
# Static assets için CDN URL (opsiyonel)
CDN_URL=""
