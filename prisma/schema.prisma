// Prisma Schema for Destiny Rising Hub
// Database: SQLite (development) / PostgreSQL (production)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// ─── Better Auth Models ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  username      String    @unique
  displayName   String
  avatar        String?
  provider      String
  providerAccountId String
  role          String    @default("user")
  locale        String    @default("en")
  theme         String    @default("dark")
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime  @default(now())

  // Relations
  favorites     Favorite[]
  savedBuilds   SavedBuild[]
  savedTeams    SavedTeam[]
  collections   Collection[]
  activities    Activity[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─── User Platform Models ───

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  type       String   // character, weapon, build, team
  itemId     String
  itemName   String
  itemSlug   String
  itemIcon   String
  itemColor  String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, itemId])
  @@index([userId, type])
  @@map("favorites")
}

model SavedBuild {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String?
  characterId   String
  characterName String
  weaponId      String
  weaponName    String
  artifactSetIds String  // JSON array stored as string
  tags          String   // JSON array stored as string
  notes         String?
  isPublic      Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_builds")
}

model SavedTeam {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  memberIds   String   // JSON array stored as string
  template    String?
  tags        String   // JSON array stored as string
  notes       String?
  isPublic    Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_teams")
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  icon        String?
  items       String   // JSON array stored as string
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("collections")
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  link        String?
  metadata    String?  // JSON object stored as string
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}
